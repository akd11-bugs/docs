  "keyFeatures": [
    "Payment Links — create hosted, shareable payment URLs for customers",
    "PayIn API — programmatically initiate payment transactions (QR, UPI Intent, cards, netbanking)",
    "Payout API — transfer funds to beneficiaries via IMPS, NEFT, RTGS",
    "Refund API — initiate and track refunds for completed PayIn transactions",
    "Webhook callbacks — real-time transaction status updates delivered to merchant endpoints",
    "X-API-Key authentication — short-lived tokens with IP whitelisting for secure API access",
    "Merchant Dashboard — manage credentials, API keys, IP whitelist, webhooks, and support tickets"
  ],
  "publicApiSurface": [
    "GET  https://auth.fastflowpe.com/system/generate_x_api_token_merchant",
    "POST https://api.fastflowpe.com/merchant/payment-links/create",
    "GET  https://api.fastflowpe.com/merchant/payment-links/v3/check-payment-status",
    "GET  https://api.fastflowpe.com/merchant/payment-links/v3/get-payin-providers",
    "POST https://api.fastflowpe.com/merchant/payin/initialize",
    "POST https://api.fastflowpe.com/merchant/payin/status",
    "POST https://api.fastflowpe.com/merchant/api/v1/verification/create-beneficiary",
    "POST https://api.fastflowpe.com/merchant/api/v2/payout/initialize",
    "POST https://api.fastflowpe.com/merchant/payout/status",
    "GET  https://api.fastflowpe.com/merchant/payout/api/merchant/balance",
    "POST https://api.fastflowpe.com/merchant/payin/refund/initiate",
    "POST https://api.fastflowpe.com/merchant/payin/refund/status"
  ]
